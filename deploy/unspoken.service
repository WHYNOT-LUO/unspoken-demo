[Unit]
Description=Unspoken (未言) web app
After=network-online.target
Wants=network-online.target

[Service]
User=unspoken
Group=unspoken
WorkingDirectory=/opt/unspoken/app
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

# Hardening: the app can write only to its data and backup folders.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/unspoken /var/backups/unspoken
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
