# Copy to .env and fill in. Without LLM_API_KEY the app runs in test mode (no model called).

# DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Qwen (Alibaba DashScope), alternative:
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# Extra JSON fields sent with every model request. Default for DeepSeek: {"thinking":{"type":"disabled"}}
# LLM_EXTRA_BODY=

# Longest answer, in tokens
LLM_MAX_TOKENS=800

# Daily AI request limits, per account and for the whole site (reset at midnight China time)
LIMIT_PER_VISITOR_DAY=60
LIMIT_SITE_DAY=1500

# Where the database (unspoken.db) is kept
DATA_DIR=data

# Set to 1 to always mark the login cookie Secure (automatic behind an HTTPS proxy like Caddy)
# SECURE_COOKIES=1

# Server address. Use HOST=0.0.0.0 to allow other devices on the network.
HOST=127.0.0.1
PORT=3100

# Force test mode even with a key set
# LLM_MOCK=1

# Free trial and paid plan
# AI uses each new account gets for free (questions and AI writing help together)
FREE_AI_USES=3
# Longest free answer, in tokens (about 250 Chinese characters)
FREE_MAX_TOKENS=250
# Days a paid plan lasts when unlocked with: node scripts/admin.js grant EMAIL
PLAN_DAYS=30
# Shown on the upgrade screen, for example: PLAN_PRICE=¥19 / 30 天
PLAN_PRICE=
# How people tell you they've paid, for example: PAY_CONTACT=微信 your-wechat-id
PAY_CONTACT=
# To show a payment QR code, save the image as pay-qr.png in the DATA_DIR folder.
